# LLM Provider: 'grok', 'gemini', or 'openai' (Default is 'grok')
LLM_PROVIDER=grok

# Grok (xAI) API Key (Used if LLM_PROVIDER=grok)
GROK_API_KEY=your_grok_api_key_here

# Mistral API Key (Used if LLM_PROVIDER=mistral)
MISTRAL_API_KEY=your_mistral_api_key_here

# Gemini API Key (Used if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# NewsData.io API Key (Optional but recommended for fetching live news)
NEWSDATA_API_KEY=your_newsdata_api_key_here
